---
import Layout from "../../layouts/Layout.astro";
import PortfolioHeader from "../../components/PortfolioHeader.astro";
import PortfolioFooter from "../../components/PortfolioFooter.astro";
import ProjectVisual from "../../components/ProjectVisual.astro";
import { work } from "../../data/portfolio";

export function getStaticPaths() {
  return work.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
---
<Layout title={`${project.title} · Alex Pereyra`} description={project.description}>
  <PortfolioHeader />
  <main class="wrap inner-page" id="content" tabindex="-1">
    <a class="text-link" href="/#proyectos">Todos los proyectos</a>
    <article>
      <header class="case-header">
        <p class="eyebrow">{project.type}</p>
        <h1>{project.title}</h1>
        <p class="lead">{project.description}</p>
        <div class="actions">
          {project.site && <a class="button button-primary" href={project.site}>Abrir sitio</a>}
          {project.source && <a class="button button-outline" href={project.source}>Ver código</a>}
        </div>
      </header>
      <div class="case-cover"><ProjectVisual project={project} eager /></div>
      <div class="case-detail">
        <div class="case-meta">
          <div><h2>Mi rol</h2><p>{project.role}</p></div>
          <div><h2>Tecnologías</h2><ul class="tags">{project.stack.map((item) => <li>{item}</li>)}</ul></div>
        </div>
        <div class="case-story">
          <section><h2>El contexto</h2><p>{project.context}</p></section>
          <section><h2>Qué hice</h2><p>{project.approach}</p></section>
          <section><h2>Qué se puede explorar</h2><p>{project.outcome}</p></section>
        </div>
      </div>
    </article>
  </main>
  <PortfolioFooter />
</Layout>

---
import Layout from "../layouts/Layout.astro";
import PortfolioHeader from "../components/PortfolioHeader.astro";
import PortfolioFooter from "../components/PortfolioFooter.astro";
import ProjectVisual from "../components/ProjectVisual.astro";
import { experience, links, work } from "../data/portfolio";

const [featured, iabot] = work;
---
<Layout>
  <PortfolioHeader />
  <main id="content" tabindex="-1">
    <section class="wrap hero" aria-labelledby="hero-title">
      <div class="hero-copy" id="sobre-mi">
        <p class="eyebrow location"><span aria-hidden="true"></span>Málaga, España</p>
        <h1 id="hero-title">Frontend<br /><em>Developer</em></h1>
        <p class="hero-description">Soy Alex Pereyra, cofundador de Nodra Studio con Nico. Desarrollo interfaces con React, Next.js y TypeScript.</p>
        <div class="actions">
          <a class="button button-primary" href="/projects/nodra-studio">Conocer Nodra Studio</a>
          <a class="button button-outline" href="/cv/es">Ver CV</a>
        </div>
      </div>
      <div class="portrait">
        <img src="/redesign/alex-pereyra.webp" alt="Alex Pereyra" width="780" height="880" fetchpriority="high" decoding="async" />
      </div>
    </section>

    <section class="work-section" id="proyectos" aria-labelledby="work-title">
      <div class="wrap">
        <header class="section-heading">
          <h2 id="work-title">Proyectos</h2>
        </header>

        <article class="project-featured">
          <a class="visual-link" href={`/projects/${featured.slug}`} aria-label={`Ver caso de ${featured.title}`}>
            <ProjectVisual project={featured} />
          </a>
          <div class="project-copy">
            <p class="eyebrow">{featured.type}</p>
            <h3>{featured.title}</h3>
            <p>{featured.description}</p>
            <ul class="tags" aria-label="Tecnologías">{featured.stack.map((item) => <li>{item}</li>)}</ul>
            <div class="actions">
              <a class="text-link" href={`/projects/${featured.slug}`}>Ver proyecto</a>
              <a class="text-link" href={`${links.nodra}#proyectos`}>Ver el portafolio de Nodra</a>
            </div>
          </div>
        </article>

        <article class="project-featured project-secondary">
          <a class="visual-link" href={`/projects/${iabot.slug}`} aria-label={`Ver caso de ${iabot.title}`}>
            <ProjectVisual project={iabot} />
          </a>
          <div class="project-copy">
            <p class="eyebrow">{iabot.type}</p>
            <h3>{iabot.title}</h3>
            <p>{iabot.description}</p>
            <a class="text-link" href={`/projects/${iabot.slug}`} aria-label={`Ver caso de ${iabot.title}`}>Ver caso</a>
          </div>
        </article>

        <aside class="lab-strip" id="laboratorio">
          <div>
            <h3>Laboratorio frontend</h3>
            <p>Una pieza HTML5 con GSAP, una mesa de soporte y un explorador de talleres.</p>
          </div>
          <a class="text-link" href="/lab">Probar el laboratorio</a>
        </aside>
      </div>
    </section>

    <section class="wrap experience-section" id="experiencia" aria-labelledby="experience-title">
      <header class="section-heading">
        <h2 id="experience-title">Experiencia</h2>
      </header>
      <ul class="experience-list">
        {experience.map((entry) => (
          <li>
            <div>
              <h3>{entry.organization}</h3>
              <p class="role">{entry.role}</p>
              <p class="period">{entry.period}</p>
            </div>
            <p>{entry.detail}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="contact-section" id="contacto" aria-labelledby="contact-title">
      <div class="wrap contact-inner">
        <h2 id="contact-title">Hablemos.</h2>
        <div>
          <p>Para oportunidades de frontend, proyectos web y colaboraciones.</p>
          <div class="actions">
            <a class="button button-dark" href={links.email}>Escribime</a>
            <a class="button button-outline" href={links.linkedin}>LinkedIn</a>
            <a class="button button-outline" href={links.github}>GitHub</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <PortfolioFooter />
</Layout>

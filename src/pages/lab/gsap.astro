---
import Layout from "../../layouts/Layout.astro";
import PortfolioHeader from "../../components/PortfolioHeader.astro";
import PortfolioFooter from "../../components/PortfolioFooter.astro";
---
<Layout title="Laboratorio de movimiento · Alex Pereyra" description="Experimentos de interacción en CSS y GSAP.">
  <PortfolioHeader />
  <main class="wrap inner-page" id="content" tabindex="-1">
    <a class="text-link" href="/#laboratorio">Volver a proyectos</a>
    <header class="inner-header">
      <h1>Laboratorio de movimiento</h1>
      <p class="lead">Pruebas de cómo cambia una interfaz al pulsar un control o desplazarse por una página.</p>
    </header>
    <section class="demo-preview" aria-labelledby="demo-title">
      <h2 id="demo-title">Cambio de estado en CSS</h2>
      <div class="demo-control">
        <div class="demo-stage" id="demo-stage" data-open="false">
          <div class="demo-card"><strong id="demo-status" role="status">En pausa</strong></div>
        </div>
        <button type="button" class="button button-primary" id="demo-toggle" aria-pressed="false" aria-controls="demo-stage" hidden>Activar tarjeta</button>
        <noscript>Activá JavaScript para probar el cambio de estado.</noscript>
      </div>
    </section>
    <section class="demo-notes" aria-labelledby="demos-gsap">
      <h2 id="demos-gsap">Archivo GSAP</h2>
      <p>Estas demos incluyen animaciones ligadas al desplazamiento de la página.</p>
      <ul class="demo-links">
        <li><a class="text-link" href="/demos/scroll-progress/index.html">Progreso de lectura</a></li>
        <li><a class="text-link" href="/demos/scrolltrigger-timeline/index.html">Secuencia con ScrollTrigger</a></li>
      </ul>
    </section>
  </main>
  <PortfolioFooter />
</Layout>
<script>
  const button = document.querySelector<HTMLButtonElement>("#demo-toggle");
  const stage = document.querySelector<HTMLElement>("#demo-stage");
  const status = document.querySelector<HTMLElement>("#demo-status");

  if (button && stage && status) {
    button.hidden = false;
    button.addEventListener("click", () => {
      const active = stage.dataset.open === "true";
      stage.dataset.open = String(!active);
      button.setAttribute("aria-pressed", String(!active));
      status.textContent = active ? "En pausa" : "Activa";
    });
  }
</script>

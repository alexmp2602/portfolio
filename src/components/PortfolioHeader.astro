---
const { english = false } = Astro.props;
---
<header class="site-header" id="inicio">
  <div class="wrap header-row">
    <a class="brand" href="/" aria-label={english ? "Alex Pereyra, home" : "Alex Pereyra, inicio"}>
      <img src="/favicon.svg?v=2" width="36" height="36" alt="" />
      <span>Alex Pereyra</span>
    </a>
    <nav aria-label={english ? "Main navigation" : "Navegación principal"}>
      <a href="/#proyectos">{english ? "Work" : "Proyectos"}</a>
      <a href="/#experiencia">{english ? "Experience" : "Experiencia"}</a>
      <a class="nav-contact" href="/#contacto">{english ? "Contact" : "Contacto"}</a>
    </nav>
  </div>
</header>

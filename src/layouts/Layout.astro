---
import "../styles/portfolio.css";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  lang?: "es" | "en";
  noindex?: boolean;
}

const {
  title = "Alex Pereyra · Frontend Developer en Málaga",
  description = "Frontend Developer en Málaga y cofundador de Nodra Studio. Proyectos con React, Next.js y TypeScript, experiencia y contacto.",
  ogImage = "/redesign/compartir.jpg",
  lang = "es",
  noindex = false,
} = Astro.props;
const origin = "https://www.alexpereyra.dev";
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const canonical = new URL(path, origin).href;
const socialImage = new URL(ogImage, origin).href;
const profile = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Alex Pereyra",
  jobTitle: "Frontend Developer",
  url: origin,
  image: new URL("/redesign/alex-pereyra.webp", origin).href,
  sameAs: ["https://www.linkedin.com/in/alex-pereyra-dev/", "https://github.com/alexmp2602"],
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#f7f7f0" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="alternate icon" type="image/png" sizes="32x32" href="/redesign/icon.png?v=2" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="apple-touch-icon" href="/redesign/touch.png?v=2" />
    <link rel="preload" href="/redesign/inter.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === "es" ? "es_ES" : "en_GB"} />
    <meta property="og:site_name" content="Alex Pereyra" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {process.env.VERCEL_ENV === "production" && (
      <>
        <script is:inline>
          window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
        </script>
        <script is:inline defer src="/_vercel/insights/script.js"></script>
      </>
    )}
    {path === "/" && <script type="application/ld+json" set:html={JSON.stringify(profile)} />}
  </head>
  <body>
    <a class="skip-link" href="#content">{lang === "es" ? "Saltar al contenido" : "Skip to content"}</a>
    <slot />
  </body>
</html>

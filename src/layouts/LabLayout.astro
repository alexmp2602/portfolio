---
import Layout from "./Layout.astro";
import PortfolioHeader from "../components/PortfolioHeader.astro";
import PortfolioFooter from "../components/PortfolioFooter.astro";
import "../styles/lab.css";

interface Props {
  title: string;
  description: string;
  index?: boolean;
}

const { title, description, index = false } = Astro.props;
---
<Layout title={`${title} · Alex Pereyra`} {description}>
  <PortfolioHeader />
  <main class="wrap inner-page lab" id="content" tabindex="-1">
    <a class="text-link" href={index ? "/#laboratorio" : "/lab"}>{index ? "Volver al portafolio" : "Volver al laboratorio"}</a>
    <header class="inner-header lab-header">
      <h1>{title}</h1>
      <p class="lead">{description}</p>
    </header>
    <slot />
  </main>
  <PortfolioFooter />
</Layout>
